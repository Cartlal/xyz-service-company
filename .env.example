# Copy to .env. Everything has a working default for local use.
PORT=5050
# Address customers use to reach this site (used in ticket tracking links).
PUBLIC_URL=http://localhost:5050
SESSION_SECRET=change-me-to-a-long-random-string

# First agent account, created on first start.
ADMIN_NAME=Support Admin
ADMIN_EMAIL=admin@lanterndesk.test
ADMIN_PASSWORD=lantern-admin-2026

# First client company, created on first start. Put the same key in the client
# site's env (e.g. the store's HELPDESK_API_KEY). Leave empty to generate one,
# which is printed once in the console.
DEFAULT_CLIENT_NAME=Trick or Commit
DEFAULT_CLIENT_SLUG=trick-or-commit
DEFAULT_CLIENT_URL=http://localhost:5173
DEFAULT_CLIENT_KEY=

# AutoFix. Leave AUTOFIX_URL empty to run the helpdesk without it.
# AUTOFIX_SECRET must match AutoFix's AUTOFIX_SECRET. On the AutoFix side set
# VICTORYPATH_API_URL to this helpdesk's URL so progress is posted back here.
AUTOFIX_URL=http://localhost:8000
AUTOFIX_SECRET=
AUTOFIX_SYNC_SECONDS=15

# MongoDB Atlas. The cluster can be shared with other apps (e.g. the store);
# the helpdesk only uses the MONGODB_DB database on it.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=lantern_desk
